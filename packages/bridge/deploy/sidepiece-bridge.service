# Sidepiece Bridge -- installed verbatim by `mise run deploy` (.mise/scripts/deploy-bridge.sh).
# Edit this tracked file, never the installed copy.
# Credentials (Story 1.12): systemd hands the 1Password service-account token to the Bridge as
# $CREDENTIALS_DIRECTORY/op-token; the Bridge passes it only to the `op` child. The empty
# SetCredential= fallback keeps a missing token file from refusing the unit (243/CREDENTIALS,
# which the operator would read as DS-4): the Bridge starts and reports DS-8 instead.
[Unit]
Description=Sidepiece Bridge (project-resolution daemon, loopback only)
StartLimitIntervalSec=0

[Service]
Type=simple
# Absolute, pinned Node 24.15.0 -- never PATH, shims, or the 24 / 24.15 / lts / latest aliases.
ExecStart=%h/.local/share/mise/installs/node/24.15.0/bin/node %h/.local/lib/sidepiece/bridge.mjs
WorkingDirectory=%h/.local/state/sidepiece
StateDirectory=sidepiece
Restart=always
RestartSec=2
SyslogIdentifier=sidepiece-bridge
LoadCredential=op-token:/etc/sidepiece/op-service-token
SetCredential=op-token:
# The real ELF binary, never ~/.local/bin/op (a shell wrapper with a Redis cache).
Environment=OP_BIN=/usr/bin/op

[Install]
WantedBy=default.target
